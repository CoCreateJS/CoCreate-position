{
  "name": "@cocreate/position",
  "version": "1.16.0",
  "description": "Declarative DOM positioning, dragging, snapping, and drag-and-drop for web interfaces.",
  "keywords": [
    "positioning",
    "drag-and-drop",
    "draggable",
    "snapping",
    "floating-ui",
    "popover",
    "tooltip",
    "iframe",
    "declarative",
    "dom",
    "cocreate"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "client"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "Declarative DOM positioning, dragging, snapping, and drag-and-drop for web interfaces.",
      "source": "src/index.js",
      "declarative": {
        "attributes": [
          {
            "name": "clonable-query"
          },
          {
            "name": "draggable"
          },
          {
            "name": "draggable-query"
          },
          {
            "name": "droppable-query"
          },
          {
            "name": "position-box"
          },
          {
            "name": "position-element"
          },
          {
            "name": "position-events"
          },
          {
            "name": "position-query"
          },
          {
            "name": "position-reference"
          },
          {
            "name": "snappable-query"
          }
        ],
        "selectors": [
          "[draggable], [draggable-query], [clonable-query]",
          "[droppable-query], [snappable-query], [position-reference]",
          "[position-query], [position-element], [position-events], [position-box]"
        ]
      },
      "api": {
        "exports": [
          "init",
          "initElement",
          "initElements",
          "loadDraggable",
          "loadPlacement",
          "loadSnappable"
        ]
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch",
    "test": "node --test test/*.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/CoCreate-position.git"
  },
  "author": "CoCreate LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CoCreateJS/CoCreate-position/issues"
  },
  "homepage": "https://cocreate.app/docs/position",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/observer": "^1.23.0",
    "@cocreate/utils": "^1.54.0"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.9.0",
    "playwright-core": "^1.64.1"
  },
  "allowScripts": {
    "@cocreate/observer@1.19.0": true,
    "@cocreate/utils@1.42.2": true,
    "@cocreate/webpack@1.4.3": true
  }
}
